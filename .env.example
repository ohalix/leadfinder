# ── SERP Provider ─────────────────────────────────────────────────────────────
# Get your key at https://serpapi.com/
SERP_API_KEY=your_serpapi_key_here
SERP_PROVIDER=serpapi
SERP_MAX_RESULTS=10

# ── Scraper ───────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
# Polite delay between page fetches (seconds)
RATE_LIMIT_DELAY_SECONDS=1.0
# Honest bot user-agent – update the URL to your own domain
USER_AGENT=LeadFinderBot/0.1 (+https://yourdomain.example/bot)

# ── Playwright fallback ───────────────────────────────────────────────────────
# Set to false to disable JS rendering entirely (requires playwright package)
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_TIMEOUT_MS=15000

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/leads.db

# ── Phone normalization ───────────────────────────────────────────────────────
# ISO 3166-1 alpha-2 region code used when no country code is present in a number
DEFAULT_PHONE_REGION=US

# ── Domain denylist (comma-separated) ────────────────────────────────────────
DOMAIN_DENYLIST=linkedin.com,facebook.com,twitter.com,x.com,yelp.com,indeed.com,wikipedia.org,amazon.com,ebay.com,youtube.com,instagram.com,glassdoor.com,monster.com,ziprecruiter.com,reddit.com,quora.com

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-in-production
LOG_LEVEL=INFO

# ── SMTP Email Sending ─────────────────────────────────────────────────────────
# Works with Gmail, Outlook, SendGrid SMTP relay, Mailgun, Brevo, etc.
# Gmail: enable 2FA and use an App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=LeadFinder
SMTP_USE_TLS=true
